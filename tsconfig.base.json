{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@cintexa/shared": ["packages/shared/src"],
      "@cintexa/financial-engine": ["packages/financial-engine/src"],
      "@cintexa/document-processor": ["packages/document-processor/src"],
      "@cintexa/ai-agents": ["packages/ai-agents/src"]
    }
  }
}
